# Mobile (Expo) environment template.
# Copy to .env or .env.local in this directory. Expo inlines EXPO_PUBLIC_* vars.
#
# Base URL of the Social Cook backend:
#   iOS simulator:    http://localhost:8000
#   Android emulator: http://10.0.2.2:8000
#   Physical device:  http://<your-computer-LAN-IP>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# RevenueCat public SDK keys (optional — leave blank to disable in-app purchases,
# e.g. in Expo Go). Get these from the RevenueCat dashboard.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
