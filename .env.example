# =====================================================================
# Social Cook — backend environment template
# Copy to backend/.env and fill in real values:  cp .env.example backend/.env
# NEVER commit your real .env. Keep all secrets out of source control.
# =====================================================================

# ---- App ----
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated CORS origins. "*" is fine for local dev; lock down in prod.
CORS_ORIGINS=*

# ---- Database (PostgreSQL) — used from Phase 2 onward ----
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/social_cook

# ---- Auth (Phase 2) ----
# Generate a long random secret, e.g.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200   # 30 days

# ---- AI: recipe structuring + vision (Anthropic) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- AI: speech-to-text (OpenAI Whisper; default Transcriber provider) ----
# Pluggable behind the Transcriber interface — swap for Groq/local later.
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# ---- Monetization (Phase 5): RevenueCat server-side validation ----
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTH=    # shared secret used to verify RevenueCat webhooks
